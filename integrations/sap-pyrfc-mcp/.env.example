# Optional local defaults (chat should use sap_connect for multi-user credentials)
SAP_ASHOST=
SAP_SYSNR=00
SAP_CLIENT=100
SAP_USER=
SAP_PASSWORD=
SAP_LANGUAGE=EN
SAP_SAPROUTER=

# ADT HTTPS (optional; also derived from ashost/sysnr in sap_connect)
SAP_URL=
SAP_SESSION_TYPE=stateless
SAP_TLS_VERIFY=false
SAP_ADT_TIMEOUT=60

# Backend selection: auto | pyrfc | adt
SAP_BACKEND=auto

# Message server logon (alternative to SAP_ASHOST):
# SAP_MSHOST=
# SAP_MSSERV=3601
# SAP_GROUP=SPACE
# SAP_R3NAME=S4H

# NW RFC SDK path and runtime profile are generated by install-nwrfcsdk.sh.
# Linux selects the native source-build runtime. On Apple Silicon, an ARM64 SDK
# selects native PyRFC 3.3.1; an Intel SDK selects Rosetta/x86_64 PyRFC 3.3.
# SAPNWRFC_HOME=

# Single-process Streamable HTTP (no supergateway)
MCP_HOST=127.0.0.1
MCP_PORT=8200
MCP_PATH=/mcp
MCP_TRANSPORT=streamable-http

# Multi-user connection registry
MAX_CONNECTIONS=20
IDLE_TTL_MS=1800000
